# Copy this file to .env then add your API key to the api_key variable.
api_key=replace-with-your-api-key

model=deepseek-v4-flash
# You can change to other models if you want to compare their performance. The following models are available:
# - qwen3.8-max
# - qwen3.7-max
# - qwen3.7-plus
# - qwen3.6-flash
# - qwen3.6-plus
# - minimax-m3
# - kimi-k3
# - glm-5.3
# - glm-5.2
# - deepseek-v4-pro
# - deepseek-v4-flash

# The two models below would be deprecated in the future, please use the model names above instead.
# - deepseek-v4-pro-0813
# - deepseek-v4-flash-0731

# Please keep this base_url unchanged unless you are using a different API provider.
base_url=https://api.arc-bench.com/v1
