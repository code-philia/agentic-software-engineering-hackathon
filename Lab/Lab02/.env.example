# Copy this file to .env then add your API key to the api_key variable.
api_key=replace-with-your-api-key

model=deepseek-v4-flash
# You can change to other models if you want to compare their performance. The following models are available:
# - qwen3.8-max
# - qwen3.7-max
# - qwen3.7-plus
# - qwen3.6-flash
# - qwen3.6-plus
# - minimax-m3
# - kimi-k3
# - glm-5.3
# - glm-5.2
# - deepseek-v4-pro
# - deepseek-v4-flash

# Please keep this base_url unchanged unless you are using a different API provider.
base_url=https://api.arc-bench.com/v1

# To use ModelScope instead, replace the three active values above with a
# ModelScope API key, endpoint, and one of the corresponding model IDs below.
# Keep only one api_key/model/base_url set active at a time.
#
# api_key=replace-with-your-api-key
# base_url=https://api-inference.modelscope.cn/v1
# model=ZhipuAI/GLM-5.3-Flash
#
# Other supported classroom ModelScope model:
# model=Qwen/Qwen3.8-Flash-Next
